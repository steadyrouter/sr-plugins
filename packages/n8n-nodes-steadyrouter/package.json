{
  "name": "n8n-nodes-steadyrouter",
  "version": "0.1.1",
  "description": "SteadyRouter for n8n: chat, image and video models through one API key, plus a chat model for AI Agent.",
  "license": "MIT",
  "homepage": "https://www.steadyrouter.com/site/docs.html",
  "keywords": [
    "n8n-community-node-package",
    "steadyrouter",
    "llm",
    "ai",
    "image-generation",
    "video-generation"
  ],
  "author": {
    "name": "SteadyRouter",
    "email": "support@steadyrouter.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steadyrouter/sr-plugins.git",
    "directory": "packages/n8n-nodes-steadyrouter"
  },
  "scripts": {
    "build": "n8n-node build",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "aiNodeSdkVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SteadyRouterApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SteadyRouter/SteadyRouter.node.js",
      "dist/nodes/LmChatSteadyRouter/LmChatSteadyRouter.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.54.6",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "@types/node": "24.19.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*",
    "@n8n/ai-node-sdk": "*"
  }
}
