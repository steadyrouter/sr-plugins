{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2022",
		"lib": ["es2022"],
		"types": ["node"],
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"useUnknownInCatchVariables": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "./build"
	},
	"include": ["srclient/**/*", "tests/**/*"]
}
