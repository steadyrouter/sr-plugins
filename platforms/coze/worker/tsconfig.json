{
	"compilerOptions": {
		"strict": true,
		"module": "es2022",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["es2022", "webworker"],
		"types": [],
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"useUnknownInCatchVariables": false,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src/**/*"]
}
